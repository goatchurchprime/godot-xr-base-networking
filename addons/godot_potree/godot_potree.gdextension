[configuration]
entry_symbol = "godot_potree_library_init"
compatibility_minimum = "4.5"

[libraries]
linux.debug.x86_64 = "./bin/libgodot_potree.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./bin/libgodot_potree.linux.template_release.x86_64.so"
linux.debug.arm64 = "./bin/libgodot_potree.linux.template_debug.arm64.so"
linux.release.arm64 = "./bin/libgodot_potree.linux.template_release.arm64.so"
windows.debug.x86_64 = "./bin/libgodot_potree.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./bin/libgodot_potree.windows.template_release.x86_64.dll"
macos.debug = "./bin/libgodot_potree.macos.template_debug.framework"
macos.release = "./bin/libgodot_potree.macos.template_release.framework"
android.debug.arm64 = "./bin/libgodot_potree.android.template_debug.arm64.so"
android.release.arm64 = "./bin/libgodot_potree.android.template_release.arm64.so"
